# Numeron - 環境変数サンプル
PORT=8080
LOG_FORMAT=text
LOG_LEVEL=info
ENVIRONMENT=development

# DB (フェーズ2.2 以降で使用)
DATABASE_URL=postgres://numeron:numeron@localhost:5432/numeron?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME_SEC=300

# Redis (フェーズ3/4 以降で使用)
REDIS_URL=redis://localhost:6379/0
